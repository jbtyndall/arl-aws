{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Deny",
      "Action": [
        "ec2:AttachInternetGateway",
        "ec2:CreateInternetGateway",
        "ec2:CreateEgressOnlyInternetGateway",
        "ec2:AttachEgressOnlyInternetGateway",
        "ec2:CreateVpcPeeringConnection",
        "ec2:AcceptVpcPeeringConnection"
      ],
      "Resource": "*",
      "Condition": {
        "StringNotLike": {
          "aws:PrincipalARN": [
            "arn:*:iam::*:role/ARL-ITSCloudAdminRole",
            "arn:*:iam::*:role/CT-GlobalAdmin",
            "arn:*:iam::*:role/cloudtamer-service-role"
          ]
        }
      }
    }
  ]
}
