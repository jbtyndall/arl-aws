{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DenySESSendingExceptApprovedRoles",
      "Effect": "Deny",
      "Action": [
        "ses:SendEmail",
        "ses:SendRawEmail",
        "ses:SendTemplatedEmail",
        "ses:SendBulkEmail",
        "ses:SendBulkTemplatedEmail",
        "ses:SendBounce",
        "ses:SendCustomVerificationEmail"
      ],
      "Resource": "*",
      "Condition": {
        "ArnNotLike": {
          "aws:PrincipalArn": "arn:aws-us-gov:iam::*:role/ARL-SES-Sender-*"
        }
      }
    }
  ]
}
